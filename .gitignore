# Build output
target/
build/
build-*/
*.exe
*.pyc
__pycache__/

# Frontend build outputs (Vite dist/) inside examples/
examples/*/dist/

# Cached runtime artifacts downloaded by `picolet build`
.picolet-cache/

# Dependencies / caches
node_modules/
.venv/
.uv-cache/

